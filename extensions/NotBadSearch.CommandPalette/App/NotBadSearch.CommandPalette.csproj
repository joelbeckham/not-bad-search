<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms><PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)microsoft.windows.sdk.contracts\10.0.28000.2957\ref\netstandard2.0</CsWinRTWindowsMetadata>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" Version="0.11.260520004" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Shmuelie.WinRTServer" Version="2.1.1" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.28000.2957" ExcludeAssets="all" PrivateAssets="all" />
    <ProjectReference Include="..\Core\NotBadSearch.Core.csproj" />
    <None Update="Package.appxmanifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
